# Copy to .env and replace every placeholder before deployment.
MYSQL_DATABASE=GopherAI
MYSQL_USER=gopherai
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
RABBITMQ_USER=gopherai
RABBITMQ_PASSWORD=replace-with-a-strong-password
JWT_KEY=replace-with-a-long-random-jwt-signing-key

# Optional AI provider settings. The API starts without them, but chat and RAG require them.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=
OPENAI_BASE_URL=

# Optional host paths for ONNX image recognition. Leave unchanged only when these files exist.
ONNXRUNTIME_SHARED_LIBRARY_PATH=./models/libonnxruntime.so
IMAGENET_LABELS_PATH=./models/imagenet_classes.txt
MOBILENET_MODEL_PATH=./models/mobilenetv2-7.onnx
